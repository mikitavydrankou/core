#!/usr/bin/env bash
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive

BACKEND_REPO_URL="${backend_repo_url}"
BACKEND_REPO_BRANCH="${backend_repo_branch}"
BACKEND_REPO_SSH_KEY_PATH="${backend_repo_ssh_key_path}"
BACKEND_REPO_USE_SSH_KEY="${backend_repo_use_ssh_key}"
BACKEND_REPO_SSH_KEY="${backend_repo_ssh_key}"
APP_PORT="${app_port}"
APP_DIR="/opt/core"
APP_ROOT="/opt/mctaxi"
DUCKDNS_SUBDOMAIN="${duckdns_subdomain}"
DUCKDNS_TOKEN="${duckdns_token}"
LE_EMAIL="${letsencrypt_email}"

exec > >(tee /var/log/startup-script.log) 2>&1
set -x

apt-get update -y
apt-get install -y git docker.io curl ca-certificates rsync

# Install Docker Compose v2 as CLI plugin (fallback when package not available)
mkdir -p /usr/local/lib/docker/cli-plugins
COMPOSE_BIN=/usr/local/lib/docker/cli-plugins/docker-compose
if [ ! -x "$COMPOSE_BIN" ]; then
  curl -SL "https://github.com/docker/compose/releases/download/v2.20.2/docker-compose-linux-x86_64" -o "$COMPOSE_BIN"
  chmod +x "$COMPOSE_BIN"
fi

if ! docker compose version >/dev/null 2>&1; then
  echo "docker compose is not available" >&2
  exit 1
fi

systemctl enable --now docker

# Ensure nginx is not occupying port 80 (Traefik will bind 80/443)
systemctl disable --now nginx >/dev/null 2>&1 || true

mkdir -p /root/.ssh
chmod 700 /root/.ssh || true

ssh-keyscan github.com >> /root/.ssh/known_hosts || true
chmod 600 /root/.ssh/known_hosts || true

if [[ "$BACKEND_REPO_USE_SSH_KEY" == "true" && -n "$BACKEND_REPO_SSH_KEY" ]]; then
  cat >"$BACKEND_REPO_SSH_KEY_PATH" <<'KEY'
${backend_repo_ssh_key}
KEY
  chmod 600 "$BACKEND_REPO_SSH_KEY_PATH"
fi

# Create app root
rm -rf "$APP_ROOT"
mkdir -p "$APP_ROOT"

# DuckDNS updater (optional)
if [[ -n "$DUCKDNS_SUBDOMAIN" && -n "$DUCKDNS_TOKEN" ]]; then
  mkdir -p /opt/duckdns
  cat >/opt/duckdns/duck.sh <<'SH'
#!/bin/sh
TOKEN="${duckdns_token}"
DOMAIN="${duckdns_subdomain}"
curl -s "https://www.duckdns.org/update?domains=$DOMAIN&token=$TOKEN&ip=" >/dev/null
SH
  chmod +x /opt/duckdns/duck.sh
  /opt/duckdns/duck.sh || true
  (crontab -l 2>/dev/null; echo "*/5 * * * * /opt/duckdns/duck.sh >/dev/null 2>&1") | crontab - || true
fi

# Clone backend if URL provided (use HTTPS by default)
if [[ -n "$BACKEND_REPO_URL" ]]; then
  if [[ "$BACKEND_REPO_USE_SSH_KEY" == "true" && -f "$BACKEND_REPO_SSH_KEY_PATH" ]]; then
    export GIT_SSH_COMMAND="ssh -i $BACKEND_REPO_SSH_KEY_PATH -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes"
  fi
  git clone --depth 1 --branch "$BACKEND_REPO_BRANCH" "$BACKEND_REPO_URL" "$APP_DIR" || true

  # Support monorepo layout: /opt/core/core/app/Dockerfile
  if [ -d "/opt/core/app" ] && [ ! -d "/opt/core/core" ]; then
    ln -s /opt/core /opt/core/core
  fi
else
  mkdir -p "$APP_DIR/app"
  cat >"$APP_DIR/app/DUMMY.md" <<'EOF'
Backend not configured. Set backend_repo_url in Terraform.
EOF
fi

# Copy static webapp from cloned repo if present
if [ -d "$APP_DIR/tgwebapp" ]; then
  mkdir -p "$APP_ROOT/tgwebapp"
  rsync -a "$APP_DIR/tgwebapp/" "$APP_ROOT/tgwebapp/" || true
else
  mkdir -p "$APP_ROOT/tgwebapp"
  cat >"$APP_ROOT/tgwebapp/index.html" <<'HTML'
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>tgwebapp not found</title>
  </head>
  <body>
    <h1>tgwebapp not found</h1>
    <p>Clone a repo that contains tgwebapp or deploy a static frontend.</p>
  </body>
</html>
HTML
fi

# Write rendered docker-compose (provided by Terraform template)
cat >"$APP_ROOT/docker-compose.yml" <<'COMPOSE'
${docker_compose}
COMPOSE

chown -R root:root "$APP_ROOT"

# Prepare acme file
touch "$APP_ROOT/acme.json"
chmod 600 "$APP_ROOT/acme.json" || true

# Launch docker compose
cd "$APP_ROOT"
APP_DOCKERFILE="/opt/core/core/app/Dockerfile"
if [ ! -f "$APP_DOCKERFILE" ] && [ -f "/opt/core/app/Dockerfile" ]; then
  APP_DOCKERFILE="/opt/core/app/Dockerfile"
fi

if [ -f "$APP_DOCKERFILE" ]; then
  docker compose up -d --build
else
  docker compose up -d traefik tgweb-static
fi

echo "startup complete"
